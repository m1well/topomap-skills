  "findings": [
    {
      "id": "f1",
      "title": "customer-core and billing-core depend on each other",
      "severity": "high",
      "category": "coupling",
      "stage": 3,
      "modules": [
        "customer-core",
        "billing-core"
      ],
      "nodes": [
        "CustomerFacade",
        "CustomerCreatedListener",
        "InvoiceService"
      ],
      "evidence": "CustomerFacade -> CustomerCreatedListener (event), InvoiceService -> CustomerFacade (call)",
      "detail": "The event edge leaves customer-core and the billing address call comes straight back. Neither module can be built, tested or moved without the other.",
      "suggestion": "Put the billing address on the event payload, so billing never has to call back."
    },
    {
      "id": "f2",
      "title": "The credit check sits inside the create path",
      "severity": "medium",
      "category": "transaction",
      "stage": 4,
      "nodes": [
        "CustomerService",
        "CreditCheckClient"
      ],
      "evidence": "flow create-customer, step 6 of 11: http edge e10 between the tenant check and the insert",
      "detail": "An outbound call to another system runs between the guard and the write. As long as the credit check is slow, the transaction stays open and the endpoint waits.",
      "suggestion": "Either pull the check in front of the transaction or move it behind the insert onto the event."
    },
    {
      "id": "f3",
      "title": "shared-integration has no api class",
      "severity": "medium",
      "category": "boundary",
      "stage": 3,
      "modules": [
        "shared-integration"
      ],
      "nodes": [
        "CreditCheckClient"
      ],
      "evidence": "CustomerService -> CreditCheckClient, the only class the module exposes",
      "detail": "Callers reach the client directly, so the module has no surface it could change behind.",
      "suggestion": "A CreditCheckFacade with the two methods that are actually used."
    },
    {
      "id": "f4",
      "title": "The scheduled invoice run does not pass the AuthTokenFilter the two endpoints pass",
      "severity": "medium",
      "category": "authorization",
      "stage": 4,
      "nodes": [
        "InvoiceService",
        "AuthTokenFilter"
      ],
      "evidence": "2 of 3 flows start at AuthTokenFilter, invoice-run starts at InvoiceService",
      "detail": "The job runs without a tenant in the request scope, so InvoiceService resolves it from the customer row instead. That is correct today and stops being correct the moment an endpoint triggers the same run.",
      "suggestion": "Give the job an explicit tenant context of its own rather than borrowing the one the filter would have set."
    },
    {
      "id": "f5",
      "title": "CreditCheckClient calls the credit bureau with no timeout and no fallback",
      "severity": "high",
      "category": "transaction",
      "stage": 3,
      "nodes": [
        "CreditCheckClient",
        "CreditBureau"
      ],
      "evidence": "RestClient built without a request factory, no @Retryable, called inside the create-customer transaction",
      "detail": "The call sits between two writes of the same transaction, so a slow bureau holds a database connection open for as long as it takes to answer.",
      "suggestion": "Set a timeout, and move the call out of the transaction - score first, then open it."
    }
  ]
}
